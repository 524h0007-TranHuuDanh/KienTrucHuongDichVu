# Sao chép file này thành .env rồi điền giá trị thật
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-base64-min-64-bytes
# Khóa dùng chung cho các lời gọi service-to-service (payment -> auth/tuition).
# BẮT BUỘC điền: để trống sẽ bị 403 ở /debit, /credit, /mark-paid.
INTERNAL_API_KEY=change-me-internal-key
REDIS_PASSWORD=change-me
RABBITMQ_USER=admin
RABBITMQ_PASS=change-me

# Tùy chọn - URL gốc hiện trong Swagger UI (trường `servers` của spec).
# Để trống sẽ dùng mặc định http://localhost:8080 (qua API Gateway).
# Đổi khi deploy sau domain/proxy khác, VD: https://api.truong.edu.vn
OPENAPI_SERVER_URL=http://localhost:8080

# Tùy chọn - dùng cho notification-service gửi email
EMAIL_USER=
EMAIL_PASS=
